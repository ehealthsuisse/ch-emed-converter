meta {
  name: CHMED23A JSON to CH EMED
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed23a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": ""
  }
}

script:post-response {
  // input for the following requests
  if (res.status === 200) bru.setVar("chEmedFrom23a", res.body.output);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("outputMediaType application/fhir+json", function () {
    expect(res.body.outputMediaType).to.equal("application/fhir+json");
  });
}
