meta {
  name: Official plan with patient id and author options
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed16a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": "",
    "options": {
      "patientIdentifier": {
        "system": "urn:oid:2.16.756.5.30.1.123.100.1.1.1",
        "value": "80756000000000000001"
      },
      "author": {
        "gln": "7601000000001",
        "given": "Anna",
        "family": "Beispiel",
        "organization": {
          "name": "Praxis Beispiel",
          "street": "Testweg 1",
          "zip": "3000",
          "city": "Bern",
          "country": "CH"
        }
      }
    }
  }
}

script:post-response {
  // input for the following requests
  if (res.status === 200) bru.setVar("chEmedCardOfficial", res.body.output);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("report contains DERIVED_VALUE", function () {
    const codes = res.body.report.entries.map((e) => e.code);
    expect(codes).to.include("DERIVED_VALUE");
  });
}
