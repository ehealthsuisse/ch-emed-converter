meta {
  name: Prescription without HcPerson, no option
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed16a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": ""
  }
}

tests {
  test("status 422", function () {
    expect(res.status).to.equal(422);
  });
  test("errorType CONVERSION_FAILED", function () {
    expect(res.body.errorType).to.equal("CONVERSION_FAILED");
  });
  test("report contains MISSING_REQUIRED_DATA", function () {
    const codes = res.body.report.entries.map((e) => e.code);
    expect(codes).to.include("MISSING_REQUIRED_DATA");
  });
}
