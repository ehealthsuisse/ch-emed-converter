meta {
  name: Prescription without HcPerson, author option
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed16a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": "",
    "options": {
      "author": {
        "gln": "7601000000001",
        "given": "Anna",
        "family": "Beispiel",
        "organization": {
          "name": "Praxis Beispiel",
          "street": "Testweg 1",
          "zip": "3000",
          "city": "Bern",
          "country": "CH"
        }
      }
    }
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("report contains DERIVED_VALUE", function () {
    const codes = res.body.report.entries.map((e) => e.code);
    expect(codes).to.include("DERIVED_VALUE");
  });
}
