meta {
  name: eRezept example with author option
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed16a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": "",
    "options": {
      "author": {
        "gln": "7601000000001",
        "given": "Anna",
        "family": "Beispiel",
        "organization": {
          "name": "Praxis Beispiel",
          "street": "Testweg 1",
          "zip": "3000",
          "city": "Bern",
          "country": "CH"
        }
      }
    }
  }
}

script:post-response {
  // input for the following requests
  if (res.status === 200) bru.setVar("chEmedRxErezept", res.body.output);
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("outputMediaType application/fhir+json", function () {
    expect(res.body.outputMediaType).to.equal("application/fhir+json");
  });
}
