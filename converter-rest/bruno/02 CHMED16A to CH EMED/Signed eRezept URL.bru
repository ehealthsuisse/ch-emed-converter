meta {
  name: Signed eRezept URL
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/conversions/chmed16a/ch-emed
  body: json
  auth: none
}

body:json {
  {
    "document": ""
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("has signature", function () {
    expect(res.body).to.have.property("signature");
  });
  test("report contains SIGNATURE_NOT_VERIFIED", function () {
    const codes = res.body.report.entries.map((e) => e.code);
    expect(codes).to.include("SIGNATURE_NOT_VERIFIED");
  });
}
