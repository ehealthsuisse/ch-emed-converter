meta {
  name: Card as QR payload
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/conversions/ch-emed/chmed16a
  body: json
  auth: none
}

body:json {
  {
    "document": "{{chEmedCard}}",
    "options": {
      "outputForm": "qr-payload"
    }
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("outputMediaType text/plain", function () {
    expect(res.body.outputMediaType).to.equal("text/plain");
  });
}
