meta {
  name: CH EMED prescription back to EPR
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/v1/conversions/ch-emed/ch-emed-epr
  body: json
  auth: none
}

body:json {
  {
    "document": "{{chEmedFromEprPre}}"
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("outputMediaType application/fhir+json", function () {
    expect(res.body.outputMediaType).to.equal("application/fhir+json");
  });
}
