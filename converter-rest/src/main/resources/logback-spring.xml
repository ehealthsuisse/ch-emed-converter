<?xml version="1.0" encoding="UTF-8"?>
<!-- REST service logging: console only, INFO. The service logs metadata only (data-model §10);
     request and response content is never passed to a logger. No file appender: Spring Boot's
     base.xml would write spring.log to the temp directory, and the service stores nothing
     (FR-005). Operators collect stdout. -->
<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <!-- HAPI FHIR and the HL7 validator log resource content at DEBUG/TRACE; keep them quiet even if
       the root level is raised (privacy, constitution IV). -->
  <logger name="org.hl7.fhir" level="WARN"/>
  <logger name="ca.uhn.fhir" level="WARN"/>
  <!-- the lenient parser warns about unknown elements of the validator's internal model -->
  <logger name="ca.uhn.fhir.parser.LenientErrorHandler" level="ERROR"/>
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
